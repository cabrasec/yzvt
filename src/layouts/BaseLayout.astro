---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'YZEV Tech | Tecnologia, IA e Soluções Digitais', description = 'Tecnologia, automação e soluções digitais sob medida.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" data-lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <link rel="stylesheet" href="/css/style.css" />
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "eb529c6115d44e4195448fda034d4ea6"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <slot />
    <script is:inline src="/js/i18n.js"></script>
    <script is:inline src="/js/main.js"></script>
    <script is:inline src="/js/form.js"></script>
  </body>
</html>
