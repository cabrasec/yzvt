---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdditionalSections from '../components/AdditionalSections.astro';
import ContactForm from '../components/ContactForm.astro';
import { projects } from '../data/projects.js';
import { services } from '../data/services.js';
---
<BaseLayout>
  <Header />
  <main id="main">
    <section class="hero" id="hero">
      <div class="hero__grid" aria-hidden="true"></div><div class="hero__glow" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__mark" aria-hidden="true"><img src="/img/yzev-monogram.svg" width="72" height="72" alt="" /></div>
        <p class="eyebrow reveal">YZEV TECH · SOFTWARE &amp; IA</p>
        <h1 class="hero__title reveal"><span>Tecnologia que transforma</span><span class="accent">ideias em soluções.</span></h1>
        <p class="hero__subtitle reveal">Desenvolvemos MicroSaaS, SaaS, automações e Inteligência Artificial sob medida para transformar desafios de negócio em soluções digitais.</p>
        <div class="hero__actions reveal"><a class="btn btn--primary" href="https://wa.me/5511973737822?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20YZEV%20Tech%20e%20gostaria%20de%20saber%20mais." target="_blank" rel="noopener noreferrer">Fale Conosco</a><a class="btn btn--ghost" href="#servicos">Conheça nossos serviços</a></div>
        <dl class="hero__pillars reveal"><div><dt>IA &amp; Automação</dt></div><div><dt>MicroSaaS &amp; SaaS</dt></div><div><dt>Desenvolvimento Web</dt></div><div><dt>Integrações &amp; APIs</dt></div></dl>
      </div>
    </section>
    <section class="section" id="servicos"><div class="container"><header class="section__head reveal"><p class="eyebrow">Serviços</p><h2>Da primeira ideia ao produto em produção.</h2><p class="section__lede">Desenvolvimento web, MicroSaaS, SaaS, inteligência artificial e automação em uma solução sob medida.</p></header><div class="pillar-grid">
      {services.map((service, index) => <a href={`/servicos/${service.slug}`} class:list={['pillar-card','reveal', service.accent ? 'pillar-card--accent' : '']}><span class="pillar-card__index">{String(index + 1).padStart(2, '0')}</span><div class="pillar-card__icon" aria-hidden="true">+</div><h3>{service.title}</h3><p>{service.summary}</p></a>)}
    </div></div></section>
    <section class="section section--dark" id="ia"><div class="container split"><div class="split__text reveal"><p class="eyebrow">Inteligência Artificial</p><h2>IA que trabalha para o seu negócio.</h2><p class="section__lede">Criamos agentes e automações inteligentes capazes de conectar informações, executar tarefas e apoiar processos de negócio.</p><a class="link-arrow" href="#contato">Fale com a YZEV Tech</a></div><div class="flow-diagram reveal" role="img" aria-label="Agentes, automação, dados, APIs, sistemas e fluxos"><div class="flow-node">Agentes</div><div class="flow-node">Automação</div><div class="flow-node flow-node--accent">Dados</div><div class="flow-node">APIs</div><div class="flow-node">Sistemas</div><div class="flow-node">Fluxos</div></div></div></section>
    <AdditionalSections />
    <section class="section" id="cases"><div class="container"><header class="section__head reveal"><p class="eyebrow">Cases</p><h2>Projetos da YZEV Tech</h2><p class="section__lede">Cada card representa um projeto específico e poderá abrir sua própria página quando os dados estiverem publicados.</p></header><div class="case-grid">{projects.length ? projects.map((project) => <a class="case-card reveal" href={`/cases/${project.slug}`}><div class="case-card__thumb"><span></span></div><p class="case-card__tag">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p></a>) : <article class="case-card reveal"><div class="case-card__thumb" aria-hidden="true"><span></span></div><p class="case-card__tag">Portfólio</p><h3>Projetos em preparação</h3><p>As páginas específicas serão adicionadas aqui com informações reais e aprovadas.</p></article>}</div></div></section>
    <section class="section section--about" id="a-yzev"><div class="container about"><div class="about__mark"><img src="/img/yzev-monogram.svg" width="120" height="120" alt="" /></div><div class="about__text reveal"><p class="eyebrow">A YZEV</p><h2>Tecnologia sob medida, da ideia ao produto.</h2><p>A YZEV Tech desenvolve soluções digitais sob medida para transformar ideias, processos e necessidades de negócio em tecnologia.</p><p>Nossa atuação combina desenvolvimento web, MicroSaaS, SaaS, inteligência artificial e automação.</p></div></div></section>
    <div class="close-run">
      <section class="section final-cta" id="contato"><div class="container final-cta__inner reveal"><img class="final-cta__mark" src="/img/yzev-monogram.svg" width="56" height="56" alt="" /><h2>Sua próxima solução começa aqui.</h2><p>Conte para a YZEV Tech o que você precisa. Vamos transformar desafios e ideias em soluções digitais.</p><a class="btn btn--primary btn--lg" href="https://wa.me/5511973737822?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20YZEV%20Tech%20e%20gostaria%20de%20saber%20mais." target="_blank" rel="noopener noreferrer">Fale Conosco</a><p class="final-cta__alt">Prefere nos contar os detalhes por escrito? <a class="link-arrow" href="#orcamento">Preencha o formulário</a></p></div></section>
      <ContactForm />
    </div>
  </main>
  <Footer />
</BaseLayout>
