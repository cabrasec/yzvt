---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects.js';
---
<BaseLayout title="Cases | YZEV Tech">
  <Header />
  <main id="main">
    <section class="hero"><div class="hero__grid" aria-hidden="true"></div><div class="hero__glow" aria-hidden="true"></div><div class="container hero__inner"><div class="hero__mark"><img src="/img/yzev-monogram.svg" width="72" height="72" alt="" /></div><p class="eyebrow">YZEV TECH · CASES</p><h1 class="hero__title"><span>Projetos que ganham</span><span class="accent">forma digital.</span></h1><p class="hero__subtitle">Conheça as soluções desenvolvidas pela YZEV Tech.</p></div></section>
    <section class="section"><div class="container"><header class="section__head"><p class="eyebrow">Cases</p><h2>Projetos da YZEV Tech</h2><p class="section__lede">Cada projeto terá uma página própria com contexto, solução e tecnologias utilizadas.</p></header><div class="case-grid">{projects.length ? projects.map((project) => <a class="case-card reveal" href={`/cases/${project.slug}`}><div class="case-card__thumb"><span></span></div><p class="case-card__tag">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p></a>) : <article class="case-card reveal"><div class="case-card__thumb"><span></span></div><p class="case-card__tag">Portfólio</p><h3>Projetos em preparação</h3><p>Os cases aparecerão aqui quando houver informações reais aprovadas para publicação.</p></article>}</div></div></section>
  </main>
  <Footer />
</BaseLayout>
