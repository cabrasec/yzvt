.next/
out/
build/
next-env.d.ts

# vercel
.vercel/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — ignora qualquer variante (.env, .env.local,
# .env.production, .env.development.local etc.); .env.example é a exceção
# porque não tem segredo nenhum, só comentário, e precisa ficar versionado
# como referência.
.env*
!.env.example

# credenciais e chaves (nenhuma existe hoje no projeto — bloqueio preventivo
# contra commit acidental caso alguém adicione no futuro)
*.pem
*.key
*.p12
*.pfx
.npmrc
credentials.json
secrets.json

# macOS-specific files
.DS_Store

# editores
.idea/
.vscode/

# Claude Code — configuração local, não compartilhada (settings.json do
# projeto, se um dia existir, continua versionável normalmente)
.claude/settings.local.json

# typescript
*.tsbuildinfo

# material de referência de design (mockups exportados, não é código-fonte)
design-reference/
AGENTS.md
